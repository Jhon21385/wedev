# ============================================================================
# COMPOSIO
#
# COMPOSIO_API_KEY is a PROJECT key — it grants access to every connected
# account in the project. It is read by the dev-server proxy (plugins/
# composio-proxy.ts) and injected server-side. It must never be prefixed with
# VITE_: Vite inlines VITE_* variables into the client bundle, which would
# publish the key to every visitor.
# ============================================================================

# Server-side. Required to publish through Composio. Never exposed to the browser.
COMPOSIO_API_KEY=

# Auth config ids per toolkit, from your Composio dashboard. These are
# identifiers, not secrets, so they are safe as VITE_* variables.
# Needed only for the first-time OAuth link of each platform.
VITE_COMPOSIO_AUTH_CONFIG_YOUTUBE=
VITE_COMPOSIO_AUTH_CONFIG_INSTAGRAM=
VITE_COMPOSIO_AUTH_CONFIG_LINKEDIN=
